# Dummy defaults for local dev, Docker and tests. Committed on purpose.
# Real secrets go in a git-ignored `.env` (or real env vars), which override these.
# `ENV` is intentionally omitted — it is set by the settings class / runtime.

PROJECT_NAME=gymhero
API_VERSION=v1
SECRET_KEY=dev-only-not-a-real-secret-change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme

POSTGRES_USER=gymhero
POSTGRES_PASSWORD=gymhero
POSTGRES_DB=workout
POSTGRES_PORT=5432
POSTGRES_HOST=db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

SERVER_HOST=0.0.0.0
SERVER_PORT=8000

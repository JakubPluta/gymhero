    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/ui": "^4.1.10",
    "jsdom": "^29.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
